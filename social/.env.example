# Variables opcionales. OpenCode lee el entorno del sistema.
# Copia a `.env` o define como variables de Windows antes de arrancar opencode.

# Bluesky (solo para postear; lectura publica funciona sin esto)
# Crear en: Bluesky > Settings > Privacy and Security > App passwords
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# BLUESKY_PDS_URL=https://bsky.social

# X/Twitter via API oficial (solo si activas twitter-isteam, requiere plan $100+/mes)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Reddit (opcional; sin esto igual navega. Con esto: 60-100 req/min + search full)
# Crear en: https://www.reddit.com/prefs/apps/ > create app > script
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# LinkedIn / YouTube / X-browser / Wattpad (perfiles browser persistentes): sin .env

# Buffer-direct (hub propio; token en publish.buffer.com > Settings > API)
BUFFER_ACCESS_TOKEN=

# Telegram (hub propio; bot con @BotFather; chat id con @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram userbot (hub propio; cuenta personal via MTProto; ritmo humano o ban)
# Crear app en https://my.telegram.org > API development tools
TG_API_ID=
TG_API_HASH=

# Discord (hub propio; webhook por canal, o bot en discord.com/developers)
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Dev.to (hub propio; key gratis en dev.to > Settings > Extensions; solo publicar)
DEVTO_API_KEY=

# Hashnode (hub propio; token en dashboard > Developer; leer pubs + publicar)
HASHNODE_TOKEN=

# Medium (hub propio; token legacy — Medium ya no emite nuevos; publica draft)
MEDIUM_TOKEN=

# Daily.dev (hub propio; token en app.daily.dev/settings/api)
DAILYDEV_TOKEN=

# Facebook Pages directo (hub propio; Meta App + pages_manage_posts)
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Hacker News (hub propio; escritura browser con cuenta; riesgo hellban en nuevas)
HN_USERNAME=ness-e
HN_PASSWORD=Eros2001*

# LinkedIn post directo (hub propio; app en developer.linkedin.com, scopes openid+profile+w_member_social)
LINKEDIN_TOKEN=
LINKEDIN_AUTHOR_URN=

# Instagram directo (hub propio; cuenta Business/Creator + app Meta)
IG_USER_ID=
IG_TOKEN=

# TikTok directo (hub propio; Content Posting API)
TIKTOK_TOKEN=
TIKTOK_OPEN_ID=

# Threads directo (hub propio; Meta app con use-case Threads)
THREADS_USER_ID=
THREADS_TOKEN=

# YouTube (hub propio; playlists con API key; upload con OAuth GCP)
YT_API_KEY=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Discord app id (hub propio; slash commands; discord.com/developers > General Information)
DISCORD_APP_ID=

# Perfiles browser con login manual 1 vez (sin .env): chrome-x, chrome-linkedin,
# chrome-reddit, chrome-daily, chrome-devto, chrome-yt, chrome-medium, chrome-hn (opcional si hay HN_*).
