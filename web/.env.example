
# Site (all NEXT_PUBLIC_* are inlined at build time: rebuild after changing)
NEXT_PUBLIC_SITE_URL=https://negentmind.com
# Public Handbook URL. Leave empty until published: the site shows
# "Handbook — publishing December 2026" as plain text.
NEXT_PUBLIC_HANDBOOK_URL=
# Contact mailto. Keep false until negentmind.com and its mailbox are live.
NEXT_PUBLIC_CONTACT_EMAIL_ENABLED=false
